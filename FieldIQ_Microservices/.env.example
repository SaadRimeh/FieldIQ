# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://fieldiq_user:fieldiq_pass@localhost:5432/fieldiq_db?schema=public"

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
ADMIN_SECRET=your_admin_panel_secret

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_INVOICE_QUEUE=fieldiq.invoice.process
RABBITMQ_RESULT_QUEUE=fieldiq.ai.results

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
